# Copy the relevant values into Server/.env and Client/.env.
# Never commit real credentials or database connection strings.

# Server/.env
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@host:5432/database
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Optional demo seed overrides
DEMO_USER_EMAIL=demo@sweety.local
DEMO_USER_PASSWORD=SweetyDemo123!
DEMO_USER_NAME=Sweety Demo
DEMO_USER_TIMEZONE=Asia/Kolkata

# Client/.env
VITE_API_URL=http://localhost:5000/api
